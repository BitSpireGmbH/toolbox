{
  "name": "dotnet-toolbox",
  "version": "1.1.1",
  "private": true,
  "description": "A developer toolkit for .NET. Installable as a PWA that runs the real .NET WebAssembly runtime in your browser, so every tool works offline.",
  "keywords": [
    "dotnet",
    "csharp",
    "aspnetcore",
    "developer-tools",
    "json-to-csharp",
    "jwt",
    "regex",
    "linq",
    "pwa",
    "offline"
  ],
  "homepage": "https://toolbox.bitspire.ch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BitSpireGmbH/toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/BitSpireGmbH/toolbox/issues"
  },
  "license": "MIT",
  "author": "BitSpire GmbH",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/write-version.mjs && npm run build:wasm && ng serve",
    "build": "node scripts/write-version.mjs && npm run build:wasm && ng build",
    "watch": "node scripts/write-version.mjs && npm run build:wasm && ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:wasm": "node scripts/clean-wasm-build.mjs && dotnet publish dotnet/Toolbox.Wasm -c Release -o dotnet/artifacts/publish && node scripts/finalize-wasm-build.mjs",
    "test:wasm": "dotnet test dotnet/Toolbox.Wasm.Tests/Toolbox.Wasm.Tests.csproj",
    "version": "node scripts/write-version.mjs && git add src/environments/app-version.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "packageManager": "npm@11.7.0",
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cdk": "^22.1.1",
    "@angular/cli": "^22.1.3",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/service-worker": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/prismjs": "^1.26.6",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-yml": "^3.8.1",
    "jsdom": "^30.0.1",
    "jwt-decode": "^4.0.0",
    "postcss": "^8.5.26",
    "prismjs": "^1.30.0",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
