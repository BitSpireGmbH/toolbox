<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".png" />
      <mimeMap fileExtension=".png" mimeType="image/png" />
      <remove fileExtension=".jpg" />
      <mimeMap fileExtension=".jpg" mimeType="image/jpeg" />
      <remove fileExtension=".jpeg" />
      <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />
      <remove fileExtension=".gif" />
      <mimeMap fileExtension=".gif" mimeType="image/gif" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <!-- .NET WebAssembly runtime under /dotnet/_framework. IIS answers 404.3 for
           an unmapped extension even when the file is right there on disk, so every
           extension the runtime ships needs an entry. Note .NET 8+ packs assemblies
           as Webcil with a .wasm extension, which conveniently sidesteps IIS request
           filtering blocking .dll outright. -->
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".dat" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <remove fileExtension=".blat" />
      <mimeMap fileExtension=".blat" mimeType="application/octet-stream" />

      <!-- `dotnet publish` emits a .br next to every compressible asset, but IIS 404s
           an unmapped extension even when the file is on disk - which is why every
           .br under /dotnet/_framework was unreachable while the .gz siblings served
           fine. The rewrite rule below is what actually uses these; this type is only
           a placeholder, because the outbound rules restore the real one. -->
      <remove fileExtension=".br" />
      <mimeMap fileExtension=".br" mimeType="application/octet-stream" />
    </staticContent>

    <!--
      The runtime is several MB uncompressed and under 3MB compressed, so this is the
      single biggest lever on how the .NET-backed tools feel on a first visit.

      Only <urlCompression> can be set here: <httpCompression>, which owns the list of
      MIME types eligible for static compression, lives in applicationHost.config and
      is locked on App Service - putting it in web.config returns HTTP 500.19.

      So this switch alone may not be enough: if `application/wasm` is not in the
      platform's staticTypes list, the runtime still transfers uncompressed. Measure
      the transferred size in DevTools after deploying. If it comes down uncompressed,
      the fallback is to serve the .br files `dotnet publish` already emits, via a
      rewrite conditioned on HTTP_ACCEPT_ENCODING plus an outbound rule setting
      Content-Encoding.
    -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <rewrite>
      <rules>
        <!--
          Serve the precompressed runtime.

          `dotnet publish` writes a .br next to every asset under _framework, at the
          highest brotli level. None of them were reachable: IIS 404s an unmapped
          extension, and nothing here mapped .br. So the CDN in front was compressing
          on the fly instead, at the low level it uses to stay fast - and skipping
          .dat entirely, because it does not compress application/octet-stream.

          Measured against production, serving the build's own .br saves 328KB:
            dotnet.native.wasm     1045KB -> 871KB
            System.Private.CoreLib  474KB -> 397KB
            icudt_EFIGS.dat         551KB -> 141KB   (was not compressed at all)

          Content-Type has to be restored on the way out, which the outbound rules
          below do. That part is load-bearing rather than cosmetic: the loader uses
          WebAssembly.instantiateStreaming, and that rejects anything not served as
          application/wasm.
        -->
        <rule name="Precompressed runtime" stopProcessing="true">
          <match url="^dotnet/_framework/(.+\.(?:wasm|dat|js))$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="dotnet/_framework/{R:1}.br" />
        </rule>

        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/assets/.*" negate="true" />
            <!-- A missing runtime file would otherwise be rewritten to index.html and
                 served as 200 HTML, which the loader then tries to parse as
                 JavaScript. Excluding the path turns that into an honest 404. -->
            <add input="{REQUEST_URI}" pattern="^/dotnet/.*" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(ngsw\.json|ngsw-worker\.js|safety-worker\.js|manifest\.webmanifest)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

    <!--
      The rewrite above hands back a .br file, so the response has to describe itself
      as the original asset, brotli-encoded - not as the octet-stream the .br MIME map
      produced. Keyed off the *original* request URI, which still carries the real
      extension; outbound rules can read {REQUEST_URI} without allowedServerVariables,
      which is locked on App Service.

      Vary is not optional here: without it a shared cache can hand a brotli body to a
      client that never asked for one.
    -->
    <outboundRules>
      <rule name="Precompressed encoding" preCondition="IsPrecompressed">
        <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
        <action type="Rewrite" value="br" />
      </rule>
      <rule name="Precompressed vary" preCondition="IsPrecompressed">
        <match serverVariable="RESPONSE_Vary" pattern=".*" />
        <action type="Rewrite" value="Accept-Encoding" />
      </rule>

      <!-- instantiateStreaming rejects a .wasm served as anything else. -->
      <rule name="Precompressed wasm type" preCondition="IsPrecompressedWasm">
        <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
        <action type="Rewrite" value="application/wasm" />
      </rule>
      <rule name="Precompressed js type" preCondition="IsPrecompressedJs">
        <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
        <action type="Rewrite" value="text/javascript" />
      </rule>
      <rule name="Precompressed dat type" preCondition="IsPrecompressedDat">
        <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
        <action type="Rewrite" value="application/octet-stream" />
      </rule>

      <preConditions>
        <preCondition name="IsPrecompressed">
          <add input="{REQUEST_URI}" pattern="^/dotnet/_framework/.+\.(wasm|dat|js)$" />
          <add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />
        </preCondition>
        <preCondition name="IsPrecompressedWasm">
          <add input="{REQUEST_URI}" pattern="^/dotnet/_framework/.+\.wasm$" />
          <add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />
        </preCondition>
        <preCondition name="IsPrecompressedJs">
          <add input="{REQUEST_URI}" pattern="^/dotnet/_framework/.+\.js$" />
          <add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />
        </preCondition>
        <preCondition name="IsPrecompressedDat">
          <add input="{REQUEST_URI}" pattern="^/dotnet/_framework/.+\.dat$" />
          <add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />
        </preCondition>
      </preConditions>
    </outboundRules>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <!-- Never cache index.html - hashed bundles are content-addressed and keep their defaults.
       Do not add <location> blocks for ngsw.json/ngsw-worker.js: a <location> path skips the
       rewrite rules above and served /ngsw.json as a bare 404. Neither needs one anyway. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
